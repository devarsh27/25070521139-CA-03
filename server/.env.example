# Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Compass / Local MongoDB connection string:
# Open MongoDB Compass -> connect to mongodb://127.0.0.1:27017 or mongodb://localhost:27017
MONGODB_URI=mongodb://127.0.0.1:27017/universe_sentiment

# (Alternative) MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/universe_sentiment?retryWrites=true&w=majority

# JWT and Cookie Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_string

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Python Executable Path for Sentiment ML Model Bridge
PYTHON_PATH=python
